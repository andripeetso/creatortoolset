{
  "name": "Creator Toolset",
  "short_name": "Creator Toolset",
  "description": "Captions, Instagram Analyzer, audio, clips, and documents — one home screen.",
  "start_url": "/m",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b10",
  "theme_color": "#0b0b10",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Instagram Analyzer",
      "short_name": "Analyzer",
      "description": "Paste a reel, carousel, or share link",
      "url": "/instagram"
    },
    {
      "name": "Caption Studio",
      "short_name": "Captions",
      "description": "Transcribe, caption, and export",
      "url": "/m/captions"
    }
  ],
  "share_target": {
    "action": "/instagram",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
