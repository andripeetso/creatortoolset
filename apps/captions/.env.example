# Creator Toolset: every setting the server reads. Copy to .env and fill in what you use.
# Leave a line empty (or delete it) to switch that feature off. Nothing here needs a value to run:
# on your own machine the app runs with no .env at all. Never commit a filled-in .env.
# `pnpm run doctor` checks a running install against this file (SELF_HOSTING.md has the steps).

# ---- Server and sign-in -------------------------------------------------------

# The public hostname Caddy serves over HTTPS (docker-compose.yml). Its DNS A record must point at the server.
DOMAIN=

# Turns on sign-in. Required on any server others can reach: without it every request is the admin.
# Production refuses to start without it. On first start your account is created with this as its
# password, so use a long random value (openssl rand -base64 32). Changing it signs everyone out.
APP_SECRET=

# Username of that account. Default: admin.
ADMIN_USERNAME=

# The address the Meta, Google and TikTok logins send people back to, e.g. https://tools.example.com.
# Empty = the address the request came in on (set it behind a proxy that rewrites the host).
PUBLIC_ORIGIN=

# The parent domain the login cookie is set on, e.g. .example.com, so every subdomain shares one sign-in.
# Empty = a cookie for the exact host only (right unless you run several subdomains of one server).
COOKIE_DOMAIN=

# Production mode and port. Docker sets both; set them yourself when running `node dist/boot.js`. Port default: 3000.
NODE_ENV=
PORT=
# The interface to listen on, e.g. 127.0.0.1 for this machine only. Empty = every interface (Docker).
HOST=
# The connect broker this computer links to (api/connect). Empty = linking from the app is off: the server has no
# default. The `creatortoolset connect` command has one: with this empty and no --broker it uses DEFAULT_BROKER
# (api/connect/cli.ts). The Mac app keeps its own default for listing the account's computers (Connect.swift) and
# does not read this.
CT_CONNECT_URL=

# Set by the Mac app when it runs the server. CT_LOCAL=1: answer only requests addressed to this Mac (localhost, its
# name, its addresses, the PUBLIC_ORIGIN host). CT_EXIT_WITH_PARENT=1: stop when stdin closes (the app quit).
CT_LOCAL=
CT_EXIT_WITH_PARENT=
# CT_MODE=hosted: this server is a hosted one (a cloud or a server you run for others). It turns on the hosted-only
# features (teams, admin, view-as) and stops watch folders. Empty = local, one person's own machine.
CT_MODE=
# Sign in with Google, Apple or GitHub, on a hosted server (api/sign-in.ts). Unset, the login screen and
# Settings → Account offer none of them. SIGNIN_ORIGIN is this server's own address; register
# <that address>/api/auth/google/callback (or /apple/, /github/) as the redirect address with each one you set up.
# SIGN_UPS=open lets a first sign-in make an account; unset, only accounts you made or invited can sign in.
# SIGNIN_ORIGIN=https://tools.example.com
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=
# APPLE_SIGNIN_TEAM_ID=
# APPLE_SIGNIN_SERVICES_ID=
# APPLE_SIGNIN_KEY_ID=
# APPLE_SIGNIN_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SIGN_UPS=

# ---- Storage ------------------------------------------------------------------

# Where projects, exports, Review videos and the account file live. Default: ~/.caption-studio.
# Docker sets /data (a volume). Back this folder up: see SELF_HOSTING.md.
DATA_DIR=

# Optional private S3-compatible bucket for uploaded source videos (AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, MinIO, ...). Set all four of ENDPOINT, BUCKET, ACCESS_KEY and SECRET_KEY, or none.
# Uploads then go straight from the browser to the bucket, which needs CORS allowing PUT from PUBLIC_ORIGIN.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Most providers use virtual-hosted bucket URLs. Set true only when your provider requires path-style.
OBJECT_STORAGE_FORCE_PATH_STYLE=

# Retention. Empty or 0 = keep. ORIGINALS_KEEP_DAYS: days before an untouched source is deleted (keep = project lifetime).
# EXPORTS_KEEP_HOURS: default 24. ENHANCE_KEEP_DAYS and INSTAGRAM_KEEP_DAYS: default keep.
ORIGINALS_KEEP_DAYS=
EXPORTS_KEEP_HOURS=
ENHANCE_KEEP_DAYS=
INSTAGRAM_KEEP_DAYS=

# Media Library uploads (/api/library): the least free space an upload may leave on the disk (GB), and the
# largest single upload (GB). Empty = 20 and 8.
LIBRARY_DISK_RESERVE_GB=
LIBRARY_MAX_UPLOAD_GB=
# Days an asset stays in the Media Library's trash before it and its files are deleted for good. Empty = 14.
LIBRARY_TRASH_DAYS=
# Media Library watch folders: folders on this server's disk whose new files join a library. Empty = on only on a
# local server (CT_MODE is not hosted) while APP_SECRET is unset (the server runs on your own computer). 1 turns them
# on anyway: then a library's owner can import any folder this server's process can read. 0 turns them off.
LIBRARY_WATCH_FOLDERS=
# The server's S3-compatible bucket that a library's owner may keep its files in (any provider that speaks S3).
# Set BUCKET and both keys to offer it; ENDPOINT empty = AWS by REGION. The keys can be pasted in Settings → API keys
# instead. Owners can also give a library its own bucket and keys in the library's storage settings.
LIBRARY_S3_ENDPOINT=
LIBRARY_S3_REGION=
LIBRARY_S3_BUCKET=
LIBRARY_S3_ACCESS_KEY=
LIBRARY_S3_SECRET_KEY=
# true only when the provider needs path-style bucket URLs.
LIBRARY_S3_FORCE_PATH_STYLE=
# How big Review uploads reach the server: "chunked" (through this server, works everywhere) or "direct" (straight to the
# bucket above). Empty = direct when the bucket is set up, else chunked. Direct without a bucket falls back to chunked.
CT_UPLOAD_RELAY=
# Bucket libraries: the most their downloaded copies (for thumbnails, proxies, transcripts) may take on this disk (GB). Empty = 20.
LIBRARY_CACHE_GB=

# ---- AI -----------------------------------------------------------------------
# The Creator Toolset Mac app runs the Claude Code and Codex command-line tools on a Mac, signed in with
# that person's own Claude or ChatGPT account. That needs no key here: pair the Mac in Settings → Providers.
# The keys below are the server's own (on a hosted server, Settings → Admin → Server keys can replace them). keyFor
# (api/my-keys.ts) gives them only to the admin, for every service but AI. AI on an API key is your own Anthropic key
# in Settings → API keys.

# The model and effort of AI calls on an Anthropic key (empty = claude-opus-5-5, low), and another API address.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_BASE_URL=

# The `claude` binary scripts/cadence-lines-for.ts runs on this machine (empty = `claude` on PATH). Scripts only.
CT_CLAUDE=

# Deepgram key: cloud transcription (nova-3). Without it, transcription runs on-device in the browser (Whisper).
DEEPGRAM_API_KEY=

# OpenAI-compatible transcription for the Media Library, used when there is no Deepgram key. The base URL points it at
# any service with the same /audio/transcriptions endpoint (empty = OpenAI); the model must return segments
# (verbose_json; empty = whisper-1).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=

# Media Library search by meaning (a library's owner switches it on): the same OpenAI-compatible key and base URL
# make the vectors through /embeddings. Model empty = text-embedding-3-small.
OPENAI_EMBED_MODEL=

# ElevenLabs key: the Audio Enhancer's voice isolation engine.
ELEVENLABS_API_KEY=

# NVIDIA key: the Audio Enhancer's second voice engine.
NVIDIA_API_KEY=

# Perplexity key: the Content Workshop's accuracy check (quick check and deep research).
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
RESEARCH_QUICK_MODEL=
RESEARCH_MODEL=

# TypeSafe key: an optional fast judge for yes/no and pick-one questions. Features keep working without it.
TYPESAFE_API_KEY=

# ---- Instagram Analyzer and connectors ---------------------------------------
# Other creators' posts are read on each person's own Apify key (Settings → API keys). APIFY_TOKEN is used only by
# the one local account when APP_SECRET is unset (your own machine), never for other accounts.
APIFY_TOKEN=
APIFY_MAX_CONCURRENT=
APIFY_BATCH_WAIT_MS=
APIFY_BATCH_SIZE=
INSTAGRAM_CONCURRENCY=
INSTAGRAM_MAX_BATCH=
INSTAGRAM_MAX_COMMENTS=
INSTAGRAM_VISION_FRAMES=
INSTAGRAM_MAX_SLIDE_MB=
INSTAGRAM_MAX_POST_MB=
INSTAGRAM_MAX_TOTAL_GB=

# The server admin's own Instagram professional account, read through the official Graph API (the admin's account
# marked Mine only; everyone else logs in with Meta in Settings → Social accounts). Nothing reads Instagram's web pages.
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_MINE_CATALOG_CAP=

# App registrations for signing people in to their own Meta, Google (YouTube) and TikTok accounts.
# Register the app with each platform yourself, with the redirect URL PUBLIC_ORIGIN + /api/connectors/callback/<meta|google|tiktok>.
# Without an app here, the login goes through the sign-in service at PLATFORM_SIGNIN_ORIGIN (default
# https://creatortoolset.com, whose apps sign people in for every install; PLATFORM_SIGNIN_ORIGIN=off turns it off). The tokens come back to this server,
# which reads the platform itself. The service is asked only when a person presses Add or Sign in on a platform in
# Settings → Social accounts: never when the server starts or a page opens. With neither, the platform is still readable by handle through an Apify token.
META_APP_ID=
META_APP_SECRET=
# a Business-type Meta app: its Facebook Login for Business configuration id (else scopes are asked for). META_LOGIN_CONFIG_ID also works.
META_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Media processing ---------------------------------------------------------

# An ffmpeg binary to use. Empty = runtime/ffmpeg (the Docker image's copy), else ffmpeg on PATH.
# Needs libass for caption burn-in.
FFMPEG_PATH=

# Concurrency limits. Each export or enhancement is CPU- and memory-heavy: raise them only on a big machine.
EXPORT_CONCURRENCY=
EXPORT_RENDER_PAGES=
ENHANCE_CONCURRENCY=
# ffmpeg runs at once for the Media Library and the AI Editor (api/library/media/run.ts). Empty = 1.
FFMPEG_CONCURRENCY=

# Video Cleaner fingerprints (PDQ, TMK, SSCD). Empty = the default folders. See docs/video-fingerprints.md.
FINGERPRINT_BIN_DIR=
SSCD_MODEL_PATH=

# Database for the old schema tooling only (db/seed.ts). The tools never use it; leave it empty.
DATABASE_URL=

# Read by lib/env.ts but not used by any feature yet.
APP_ID=

# ---- Development and test only (scripts/ and *.test.ts) ----------------------
# Community packs (api/pack-catalog.ts): Community (the account menu) reads the shared catalog at this address, and
# installed packs get update and removal notices from it. Unset, it is https://creatortoolset.com; set it to an
# empty value to turn the catalog off.
# PACK_CATALOG_URL=
# Finals: an AI post description for each linked Finals version, written once after it lands in Finals. Off unless 1
# (owner approves a sample first).
# FINALS_AUTO_DESCRIBE=1
# Dev server render URL (when NODE_ENV is not production). The caption renderer's live page.
CAPTION_RENDERER_URL=
# Set by the process manager that started the server (keeps exports pointed at the production renderer).
PM2_USAGE=
# Live tests and tools that need a real account or a remote site.
NVIDIA_LIVE=
WORKSHOP_EVAL_COOKIE=
CADENCE_BENCHMARK_URL=
SOCIAL_FEED_OWNER=
UPDATE_PROMPT_BUDGET=
# Font-parity harness (scripts/font-parity-harness.cjs).
FORCE_STYLE=
OUT=
T=
LIBRARY_SCRATCH_DIR=
