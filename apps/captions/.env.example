# Creator Toolset: every setting the server reads. Copy to .env and fill in what you use.
# Leave a line empty (or delete it) to switch that feature off. Nothing here needs a value to run:
# on your own machine the app runs with no .env at all. Never commit a filled-in .env.
# `pnpm run doctor` checks a running install against this file (SELF_HOSTING.md has the steps).

# ---- Server and sign-in -------------------------------------------------------

# The public hostname Caddy serves over HTTPS (docker-compose.yml). Its DNS A record must point at the server.
DOMAIN=

# Turns on accounts. Required on any server other people can reach: without it every request is the admin.
# Production refuses to start without it. On first start an admin account is created with this as its
# password, so use a long random value (openssl rand -base64 32). Changing it signs everyone out.
APP_SECRET=

# Username of that first admin account. Default: admin.
ADMIN_USERNAME=

# The address the Meta, Google and TikTok logins send people back to, e.g. https://tools.example.com.
# Empty = the address the request came in on (set it behind a proxy that rewrites the host).
PUBLIC_ORIGIN=

# The parent domain the login cookie is set on, e.g. .example.com, so every subdomain shares one sign-in.
# Empty = a cookie for the exact host only (right unless you run several subdomains of one server).
COOKIE_DOMAIN=

# Production mode and port. Docker sets both; set them yourself when running `node dist/boot.js`. Port default: 3000.
NODE_ENV=
PORT=

# ---- Storage ------------------------------------------------------------------

# Where projects, exports, Review videos and the account file live. Default: ~/.caption-studio.
# Docker sets /data (a volume). Back this folder up: see SELF_HOSTING.md.
DATA_DIR=

# Optional private S3-compatible bucket for uploaded source videos (AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, MinIO, ...). Set all four of ENDPOINT, BUCKET, ACCESS_KEY and SECRET_KEY, or none.
# Uploads then go straight from the browser to the bucket, which needs CORS allowing PUT from PUBLIC_ORIGIN.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Most providers use virtual-hosted bucket URLs. Set true only when your provider requires path-style.
OBJECT_STORAGE_FORCE_PATH_STYLE=

# Retention. Empty or 0 = keep. ORIGINALS_KEEP_DAYS: days before an untouched source is deleted (keep = project lifetime).
# EXPORTS_KEEP_HOURS: default 24. ENHANCE_KEEP_DAYS and INSTAGRAM_KEEP_DAYS: default keep.
ORIGINALS_KEEP_DAYS=
EXPORTS_KEEP_HOURS=
ENHANCE_KEEP_DAYS=
INSTAGRAM_KEEP_DAYS=

# Media Library uploads (/api/library): the least free space an upload may leave on the disk (GB), and the
# largest single upload (GB). Empty = 20 and 8.
LIBRARY_DISK_RESERVE_GB=
LIBRARY_MAX_UPLOAD_GB=

# ---- AI -----------------------------------------------------------------------
# The Creator Toolset Mac app runs the Claude Code and Codex command-line tools on a Mac, signed in with
# that person's own Claude or ChatGPT account. That needs no key here: pair the Mac in Settings → AI providers.
# The keys below are for the server itself: the workspace API budget that members without their own AI
# draw on, and the cloud transcription and audio tools.

# Anthropic API key (console.anthropic.com). Pays for the workspace API budget and Instagram frame reading.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
ANTHROPIC_BASE_URL=

# Deepgram key: cloud transcription (nova-3). Without it, transcription runs on-device in the browser (Whisper).
DEEPGRAM_API_KEY=

# ElevenLabs key: the Audio Enhancer's voice isolation engine.
ELEVENLABS_API_KEY=

# NVIDIA key: the Audio Enhancer's second voice engine.
NVIDIA_API_KEY=

# Perplexity key: the Content Workshop's accuracy check (quick check and deep research).
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
RESEARCH_QUICK_MODEL=
RESEARCH_MODEL=

# TypeSafe key: an optional fast judge for yes/no and pick-one questions. Features keep working without it.
TYPESAFE_API_KEY=

# ---- Instagram Analyzer and connectors ---------------------------------------
# Each person pastes their own burner-account cookies or Apify token in the app. These are server fallbacks.
APIFY_TOKEN=
APIFY_MAX_CONCURRENT=
APIFY_BATCH_WAIT_MS=
APIFY_BATCH_SIZE=
INSTAGRAM_COOKIE=
# Only if Instagram blocks the server's address on the cookie path. Node's fetch ignores HTTPS_PROXY, so this is read directly.
INSTAGRAM_PROXY_URL=
INSTAGRAM_CONCURRENCY=
INSTAGRAM_MAX_BATCH=
INSTAGRAM_MAX_COMMENTS=
INSTAGRAM_COMMENTS_TIMEOUT_S=
INSTAGRAM_VISION_FRAMES=
INSTAGRAM_MAX_SLIDE_MB=
INSTAGRAM_MAX_POST_MB=
INSTAGRAM_MAX_TOTAL_GB=

# Your own Instagram business account, read through the Graph API (accounts marked Mine only).
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_MINE_CATALOG_CAP=

# App registrations for signing people in to their own Meta, Google (YouTube) and TikTok accounts.
# Register the app with each platform yourself; the redirect URL is PUBLIC_ORIGIN plus the connector path.
# Without an app the login is hidden and the platform can still be read by handle through an Apify token.
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Media processing ---------------------------------------------------------

# An ffmpeg binary to use. Empty = runtime/ffmpeg (the Docker image's copy), else ffmpeg on PATH.
# Needs libass for caption burn-in.
FFMPEG_PATH=

# Concurrency limits. Each export or enhancement is CPU- and memory-heavy: raise them only on a big machine.
EXPORT_CONCURRENCY=
EXPORT_RENDER_PAGES=
ENHANCE_CONCURRENCY=

# Video Cleaner fingerprints (PDQ, TMK, SSCD). Empty = the default folders. See docs/video-fingerprints.md.
FINGERPRINT_BIN_DIR=
SSCD_MODEL_PATH=

# Database for the old schema tooling only (db/seed.ts). The tools never use it; leave it empty.
DATABASE_URL=

# Read by lib/env.ts but not used by any feature yet.
APP_ID=

# ---- Development and test only (scripts/ and *.test.ts) ----------------------
# Dev server render URL (when NODE_ENV is not production). The caption renderer's live page.
CAPTION_RENDERER_URL=
# Set by the process manager that started the server (keeps exports pointed at the production renderer).
PM2_USAGE=
# Live tests and tools that need a real account or a remote site.
NVIDIA_LIVE=
WORKSHOP_EVAL_COOKIE=
CADENCE_BENCHMARK_URL=
SOCIAL_FEED_OWNER=
UPDATE_PROMPT_BUDGET=
# Font-parity harness (scripts/font-parity-harness.cjs).
FORCE_STYLE=
OUT=
T=
LIBRARY_SCRATCH_DIR=
