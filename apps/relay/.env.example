# Copy to .env on the broker's host and fill in. Never commit .env.

# Shared with the hosted site: HMAC key that signs account tokens (at least 32 bytes).
RELAY_ACCOUNT_SECRET=

# Public address of this broker. The approve page is <RELAY_PUBLIC_URL>/connect.
RELAY_PUBLIC_URL=https://connect.example.com

# Domain under which each computer gets <id>.<RELAY_TUNNEL_DOMAIN>.
RELAY_TUNNEL_DOMAIN=tunnels.example.com

# Cloudflare: a token scoped to Tunnel:Edit and DNS:Edit on the tunnel zone only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Ed25519 PKCS#8 DER, base64. Unset: a key is generated into RELAY_DATA_DIR on first boot.
RELAY_SIGNING_KEY=

# Optional. Defaults shown.
RELAY_DATA_DIR=./data
PORT=44610
RELAY_LISTEN_HOST=127.0.0.1
RELAY_FREE_LIMIT=3
RELAY_REAP_AFTER=1800
RELAY_REAP_DRY_RUN=1
