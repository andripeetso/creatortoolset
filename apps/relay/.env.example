# Copy to .env on the broker's host and fill in. Never commit .env.

# Shared with the hosted site: HMAC key that signs account tokens (at least 32 bytes).
RELAY_ACCOUNT_SECRET=

# Public address of this broker. The approve page is <RELAY_PUBLIC_URL>/connect.
RELAY_PUBLIC_URL=https://connect.example.com

# Domain under which each computer gets <id>.<RELAY_TUNNEL_DOMAIN>: a zone of its own, so the free certificate covers it.
RELAY_TUNNEL_DOMAIN=example-tunnels.com

# Cloudflare: a token scoped to Tunnel:Edit and DNS:Edit on the tunnel zone only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Turns on the address for AI apps (ChatGPT, Claude): <RELAY_PUBLIC_URL>/mcp passes each request on to the
# person's own computer. At least 32 bytes; it seals the keys computers give their connections, so losing it means
# everyone connects again. Unset: none of those routes exist.
RELAY_GRANT_SECRET=
# Optional. The token the ChatGPT directory gives to prove this domain is yours, served at /.well-known/openai-apps-challenge.
RELAY_OPENAI_APPS_CHALLENGE=

# Optional. Ed25519 PKCS#8 DER, base64. Unset: a key is generated into RELAY_DATA_DIR on first boot.
RELAY_SIGNING_KEY=

# Optional. Defaults shown.
RELAY_DATA_DIR=./data
PORT=44610
RELAY_LISTEN_HOST=127.0.0.1
RELAY_FREE_LIMIT=3
RELAY_REAP_AFTER=1800
RELAY_REAP_DRY_RUN=1
