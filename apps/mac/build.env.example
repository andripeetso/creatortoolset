# Copy to apps/mac/build.env (git-ignored) and uncomment what this build needs. scripts/build-app.sh reads the file at
# build time. Every setting is optional: an empty build.env is the public build (bundle id com.creatortoolset.mac,
# no default server). A setting already in the environment wins over this file: release.sh sets FEED_URL and
# SPARKLE_PUBLIC_KEY that way, so a public release always carries the public feed.

# The bundle id. Keep the id of an installed build, or it can't receive its updates.
# BUNDLE_ID=com.example.creatortoolset.mac

# The name in the menu bar and the Dock.
# APP_NAME="Creator Toolset"

# The appcast this build checks for updates, and the EdDSA public key that signs its updates (Sparkle's generate_keys -p).
# Set both or neither.
# FEED_URL=https://example.com/mac-app/appcast.xml
# SPARKLE_PUBLIC_KEY=base64-public-key-from-generate_keys

# The server added to the Servers list once, on first launch: https, or http for localhost.
# DEFAULT_SERVER=https://tools.example.com
