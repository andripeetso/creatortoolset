{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./contracts/*"],
      "@db/*": ["./db/*"]
    }
  },
  "exclude": ["api/**/*.e2e.test.ts"],
  "include": ["api", "plugins/**/plugin.ts", "plugin-examples/**/plugin.ts", "editor-steps/**/*.ts", "contracts", "db", "src/lib/document-markdown.ts", "src/lib/instagram-markdown.ts", "src/lib/workshop-markdown.ts", "src/lib/carousel-visualize.ts", "src/lib/carousel-layout.ts"]
}
