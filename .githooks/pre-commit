#!/usr/bin/env bash
# Pre-commit gate. Enable once per clone: git config core.hooksPath .githooks
# 1. scripts/check-public.sh: no private names, hosts, addresses or ids in any file, and no private file names.
# 2. gitleaks on the staged lines: no key or token. A false positive: add `# gitleaks:allow` on that line.
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-public.sh" || exit 1

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks), secret check skipped" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -v
